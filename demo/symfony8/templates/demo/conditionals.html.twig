{% extends 'base.html.twig' %}

{% block title %}WordTemplate — conditionals{% endblock %}

{% block body %}
  <h1>Conditionals</h1>
  <p class="lead">
    Two ways to show or hide a part of the document. <strong>Named blocks</strong>
    (<code>${{ '{' }}#if annex}</code> &hellip; <code>${{ '{' }}#endif annex}</code>) are decided in PHP with a
    <code>ConditionalBlock</code> and a <code>bool</code>. <strong>Expression conditionals</strong>
    (<code>${{ '{' }}#if order.total &gt; 100}</code> &hellip; <code>${{ '{' }}#endif}</code>, bundle 1.8, opt-in) carry
    the condition in the template and are evaluated against the context.
    Each field below has a different PHP type: the controller turns it into named blocks with the expressions of
    <code>docs/USAGE.md</code> (&ldquo;Conditionals by data type&rdquo;) and passes the raw values as <code>order</code>
    for the expression blocks. Preview the decisions, then download <code>public/demo/{{ template_filename }}</code>
    filled in, or <a href="{{ path('demo_conditionals_template') }}">download the blank template</a>.
    Step-by-step cases (Word text, PHP context, result, downloads) are on the
    <a href="{{ path('demo_conditionals_examples') }}">expression examples</a> page.
  </p>

  <div class="alert alert-info small">
    <strong>{{ template_blocks|length }} conditional block(s)</strong> found by <code>listConditionalBlocks()</code>:
    {% for name in template_blocks %}<code class="me-1">{{ name }}</code>{% endfor %}
  </div>

  <div class="row g-4">
    <div class="col-lg-5">
      {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
        <fieldset class="border rounded p-3 mb-3 demo-fieldset">
          <legend class="float-none w-auto px-2 fs-6">Input values</legend>
          {% for child in form %}
            {% if not child.rendered and child.vars.name not in ['preview', 'download', '_token'] %}
              {{ form_row(child) }}
            {% endif %}
          {% endfor %}
        </fieldset>
        <div class="d-flex flex-wrap gap-2">
          {{ form_widget(form.preview) }}
          {{ form_widget(form.download) }}
        </div>
        {# REQ-TWIG-003: render whatever is left (CSRF token, …). #}
        {% for child in form %}
          {% if not child.rendered %}
            {{ form_row(child) }}
          {% endif %}
        {% endfor %}
      {{ form_end(form) }}
    </div>

    <div class="col-lg-7">
      <h2 class="h5">Decisions {% if not submitted %}<span class="badge bg-secondary">default values</span>{% endif %}</h2>
      <table class="demo-table mb-3" data-testid="decisions">
        <thead>
          <tr><th>Type</th><th>Value</th><th>Expression</th><th>Blocks</th></tr>
        </thead>
        <tbody>
          {% for decision in decisions %}
            <tr>
              <td class="small text-nowrap">{{ decision.type }}</td>
              <td class="small"><code>{{ decision.value }}</code></td>
              <td class="small"><code>{{ decision.expression }}</code></td>
              <td class="small">
                {% for name, visible in decision.blocks %}
                  <span class="badge {{ visible ? 'bg-success' : 'bg-light text-secondary border' }} me-1" title="{{ visible ? 'kept' : 'removed' }}">{{ name }}</span>
                {% endfor %}
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
      <h2 class="h5 mt-4">Expression conditionals in the template</h2>
      <table class="demo-table mb-3" data-testid="expressions">
        <thead>
          <tr><th>In Word</th><th>Paragraph inside the block</th><th>Result</th></tr>
        </thead>
        <tbody>
          {% for row in expressions %}
            <tr>
              <td class="small"><code>${{ '{' }}#if {{ row.expression }}}</code></td>
              <td class="small">{{ row.text }}</td>
              <td class="small text-nowrap">
                {% if row.error %}
                  <span class="badge bg-danger" title="{{ row.error }}">error</span>
                {% else %}
                  <span class="badge {{ row.visible ? 'bg-success' : 'bg-light text-secondary border' }}">{{ row.visible ? 'kept' : 'removed' }}</span>
                {% endif %}
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
      <p class="small text-muted mb-0">
        Green blocks are kept, grey ones are removed with their content. Try <code>0</code> vs an empty discount,
        a total of <code>0.004</code> (rounds to 0.00), <code>yes</code>/<code>0</code> as notes, <code>es</code> vs <code>ES</code>,
        a past due date with status &ldquo;Paid&rdquo;, or an empty order-lines box.
      </p>
    </div>
  </div>

{% endblock %}
