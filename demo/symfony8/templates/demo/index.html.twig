{% extends 'base.html.twig' %}

{% block title %}WordTemplate — demo (Symfony 8){% endblock %}

{% block nowo_ui_page_header %}
  {{ include(nowo_ui_partial('page_header'), {title: 'WordTemplateBundle'}) }}
{% endblock %}

{% block body %}
  {# Sanitization marker mirroring App\Form\WordTemplateFormType::DOT_PLACEHOLDER #}
  {% set DOT = '_DOT_' %}

  <p>
    This page reads <code>public/demo/{{ template_filename }}</code> with PHPWord
    <code>TemplateProcessor::getVariables()</code>, lists every <code>${variable}</code> placeholder it finds and
    builds the form below. Submit it to download a filled <code>.docx</code>, or
    <a href="{{ path('demo_template') }}">download the blank template</a> with placeholders intact.
  </p>

  <div class="nowo-ui-flash nowo-ui-flash--info" role="note">
    <strong>{{ all_variables|length }} placeholder(s)</strong> discovered in the template:
    {% for v in all_variables %}<code>${{ '{' }}{{ v }}{{ '}' }}</code>{% endfor %}
  </div>

  <details class="nowo-ui-card">
    <summary class="nowo-ui-card__title">Bundle features covered by this demo</summary>
    <ul>
      <li><span class="nowo-ui-badge nowo-ui-badge--neutral">Scalar</span> — text fields (e.g. <code>${chapter.title}</code>, dot keys).</li>
      <li><span class="nowo-ui-badge nowo-ui-badge--neutral">Inline scalar</span> — <code>${client_tier_label}</code> in one paragraph; VIP checkbox picks <em>Gold</em> or <em>Standard</em> in PHP (not a block conditional).</li>
      <li><span class="nowo-ui-badge nowo-ui-badge--neutral">HtmlContent</span> — rich HTML fields (abstract, *.body, …).</li>
      <li><span class="nowo-ui-badge nowo-ui-badge--neutral">TableRows</span> — repeating table rows (<code>row_code</code>, <code>ref_text</code>).</li>
      <li><span class="nowo-ui-badge nowo-ui-badge--neutral">ConditionalBlock</span> — <code>${{ '{' }}#if optional_funding}</code> … <code>${{ '{' }}#endif optional_funding}</code>.</li>
      <li><span class="nowo-ui-badge nowo-ui-badge--neutral">Nested conditional</span> — <code>${{ '{' }}#if funding_detail}</code> inside <code>optional_funding</code>.</li>
      <li><span class="nowo-ui-badge nowo-ui-badge--neutral">ImageSource</span> — <code>${demo_logo}</code> from a filesystem path.</li>
      <li><span class="nowo-ui-badge nowo-ui-badge--neutral">Config</span> — <code>config/packages/nowo_word_template.yaml</code> (macro and conditional delimiters).</li>
    </ul>
  </details>

  <details class="nowo-ui-card">
    <summary class="nowo-ui-card__title">HTML supported in <span class="nowo-ui-badge nowo-ui-badge--neutral">HtmlContent</span> fields</summary>
    <ul>
      <li>Inline: <code>&lt;strong&gt;</code>, <code>&lt;em&gt;</code>, <code>&lt;code&gt;</code>, <code>&lt;u&gt;</code>, line breaks.</li>
      <li>Block: <code>&lt;p&gt;</code> (multiple paragraphs OK).</li>
      <li>Tables: <code>&lt;table&gt;&lt;tr&gt;&lt;td&gt;…&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;</code> with inline <code>style</code> (borders, <code>background-color</code>, padding). PHPWord expects border shorthand as <code>width color style</code>, e.g. <code>border: 1px #2c5282 solid</code>.</li>
      <li><strong>Lists</strong> (<code>&lt;ul&gt;</code>/<code>&lt;ol&gt;</code>) require a <code>numberingStyle</code> in the parent <code>PhpWord</code> instance — not registered by the bundle's <code>HtmlContent</code> right now. Use bulleted/numbered <code>&lt;p&gt;</code> tags instead, or pair with <a href="https://github.com/nowo-tech/HtmlToWordBundle">HtmlToWordBundle</a> for a full HTML pipeline.</li>
    </ul>
    <p>The defaults below show: inline formatting, multi-paragraph blocks, simulated lists with bullets, and an inline HTML table in <code>${methodology.body}</code> and <code>${results.body}</code> — submit the form to see them in the resulting <code>.docx</code>.</p>
  </details>

  {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
    {% set fields_by_group = {} %}
    {% for var in simple_vars %}
      {% set group = (var matches '/\\./') ? var|split('.', 2)|first : '_general' %}
      {% set fields_by_group = fields_by_group|merge({ (group): (fields_by_group[group]|default([]))|merge([var]) }) %}
    {% endfor %}

    {% for group, vars in fields_by_group %}
      <section class="nowo-ui-card">
        <h2 class="nowo-ui-card__title">{{ group == '_general' ? 'General' : group }}</h2>
        <div>
          {% for var in vars %}
            {% set is_html = var in html_vars %}
            {% set field   = form.placeholders[var|replace({'.': DOT})] %}
            <div>
              {% if is_html %}<span class="nowo-ui-badge nowo-ui-badge--neutral">HtmlContent</span>{% endif %}
              {{ form_row(field) }}
            </div>
          {% endfor %}
        </div>
      </section>
    {% endfor %}

    {% for anchor, cells in row_groups %}
      {% set collection = form.rows[anchor|replace({'.': DOT})] %}
      <section class="nowo-ui-card">
        <h2 class="nowo-ui-card__title">
          Repeating rows <span class="nowo-ui-badge nowo-ui-badge--neutral">TableRows({{ anchor }})</span>
        </h2>
        <p class="nowo-ui-muted">
          Anchor placeholder <code>${{ '{' }}{{ anchor }}{{ '}' }}</code>
          {% if cells|length > 1 %}with cells {% for c in cells %}<code>${{ '{' }}{{ c }}{{ '}' }}</code>{% endfor %}{% endif %}
          — empty rows are dropped.
        </p>

        <table class="nowo-ui-data-table nowo-ui-data-table--compact">
          <thead>
            <tr>
              {% for cell in cells %}
                <th>${{ '{' }}{{ cell }}{{ '}' }}</th>
              {% endfor %}
            </tr>
          </thead>
          <tbody>
            {% for entry in collection %}
              <tr>
                {% for cell in cells %}
                  {% set cell_field = entry[cell|replace({'.': DOT})] %}
                  <td>{{ form_widget(cell_field) }}</td>
                {% endfor %}
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </section>
    {% endfor %}

    {% if conditional_blocks is not empty %}
      <section class="nowo-ui-card">
        <h2 class="nowo-ui-card__title">
          Conditional blocks <span class="nowo-ui-badge nowo-ui-badge--neutral">ConditionalBlock</span>
        </h2>
        <p class="nowo-ui-muted">
          Twig-style regions in the template:
          {% for block, _label in conditional_blocks %}
            <code class="me-2">${{ '{' }}#if {{ block }}{{ '}' }}</code>…<code>${{ '{' }}#endif {{ block }}{{ '}' }}</code>{% if not loop.last %},{% endif %}
          {% endfor %}
        </p>
        <div>
          {% for block, label in conditional_blocks %}
            {% set field = form.conditionals[block|replace({'.': DOT})] %}
            {{ form_row(field) }}
            <code>${{ '{' }}#if {{ block }}{{ '}' }}</code>
          {% endfor %}
        </div>
      </section>
    {% endif %}

    <section class="nowo-ui-card">
      <h2 class="nowo-ui-card__title">
        Inline scalar <span class="nowo-ui-badge nowo-ui-badge--neutral">computed in PHP</span>
      </h2>
      <p class="nowo-ui-muted">
        Same paragraph as normal text — template has <code>${client_tier_label}</code>; the checkbox below sets
        <em>Gold</em> or <em>Standard</em> (no <code>${{ '{' }}#if}</code> markers in the line).
      </p>
      {{ form_row(form.scalar_choices.client_is_vip) }}
    </section>

    {% if image_placeholders is not empty %}
      <section class="nowo-ui-card">
        <h2 class="nowo-ui-card__title">
          Images <span class="nowo-ui-badge nowo-ui-badge--neutral">ImageSource</span>
        </h2>
        <p class="nowo-ui-muted">Absolute path on the demo container/host (default: bundled <code>demo-logo.png</code>).</p>
        {% for imageVar in image_placeholders %}
          {% set field = form.images[imageVar|replace({'.': DOT})] %}
          {{ form_row(field) }}
        {% endfor %}
      </section>
    {% endif %}

    <p>
      <a href="{{ path('demo_template') }}" class="nowo-ui-btn nowo-ui-btn--outline">Download blank template</a>
      {{ form_widget(form.submit) }}
      {{ form_widget(form.submit_pdf) }}
      <span class="nowo-ui-muted">PDF backend: PhpWord + DomPDF (<code>docx → HTML → PDF</code>) — fidelity is limited (no headers/footers, no <code>numberingStyle</code> lists, simplified tables).</span>
    </p>
    {# REQ-TWIG-003 rule 3: the fieldsets above group the placeholders on purpose; the loop renders any remaining child. #}
    {% for child in form %}
      {% if not child.rendered %}
        {{ form_row(child) }}
      {% endif %}
    {% endfor %}
    {{ form_errors(form) }}
  {{ form_end(form) }}
{% endblock %}
