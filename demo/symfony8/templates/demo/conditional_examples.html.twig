{% extends 'base.html.twig' %}

{% block title %}WordTemplate — {{ section|lower }}{% endblock %}

{% block nowo_ui_page_header %}
  {{ include(nowo_ui_partial('page_header'), {
    title: heading,
    intro: 'Each card is a small template built from the "In Word" text (one paragraph per line, markers in blue) merged with the PHP context next to it. Download the template and the generated document to open them in Word. The same cases are documented and tested in the bundle\'s docs/USAGE.md ("' ~ section ~ '"); this demo enables them with nowo_word_template.' ~ flag ~ ': true. Lines starting with | are table rows.',
  }) }}
{% endblock %}

{% block body %}
  {% for example in examples %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: example.title, intro: example.note, kind: 'content', testid: 'example-' ~ example.id, example: example} %}
      {% block section_actions %}
        <a class="nowo-ui-btn nowo-ui-btn--outline nowo-ui-btn--sm" href="{{ path('demo_conditionals_example', {id: example.id, kind: 'template'}) }}">template .docx</a>
        {% if not example.error %}
          <a class="nowo-ui-btn nowo-ui-btn--outline nowo-ui-btn--sm" href="{{ path('demo_conditionals_example', {id: example.id, kind: 'result'}) }}">generated .docx</a>
        {% endif %}
      {% endblock %}
      {% block section_body %}
        <div class="nowo-ui-cards">
          <div>
            <h3>In Word</h3>
            <pre class="nowo-ui-code-block nowo-ui-code-block--wrap">{% for line in example.word %}{{ line }}
{% endfor %}</pre>
          </div>
          <div>
            <h3>In PHP</h3>
            <pre class="nowo-ui-code-block nowo-ui-code-block--wrap">{{ example.php }}</pre>
          </div>
          <div>
            <h3>Result</h3>
            {% if example.error %}
              <p data-testid="example-error-message"><span class="nowo-ui-badge nowo-ui-badge--danger">error</span> <code class="nowo-ui-code">ConditionalExpressionException</code>: {{ example.error }}</p>
            {% else %}
              <pre class="nowo-ui-code-block nowo-ui-code-block--wrap" data-testid="example-result">{% for line in example.lines %}{{ line }}
{% endfor %}</pre>
            {% endif %}
          </div>
        </div>
      {% endblock %}
    {% endembed %}
  {% endfor %}
{% endblock %}
