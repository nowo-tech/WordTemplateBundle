{% extends 'base.html.twig' %}

{% block title %}WordTemplate — {{ section|lower }}{% endblock %}

{% block nowo_ui_page_header %}
  {{ include(nowo_ui_partial('page_header'), {
    title: heading,
    intro: 'Each card is a small template built from the "In Word" text (one paragraph per line, markers in blue) merged with the PHP context next to it. Download the template and the generated document to open them in Word. The same cases are documented and tested in the bundle\'s docs/USAGE.md ("' ~ section ~ '"); this demo enables them with nowo_word_template.' ~ flag ~ ': true. Lines starting with | are table rows.',
  }) }}
{% endblock %}

{% block body %}
  {% for example in examples %}
    <section class="nowo-ui-card" data-testid="example-{{ example.id }}" id="example-{{ example.id }}">
      <div class="nowo-ui-card__header">
        <h2 class="nowo-ui-card__title">{{ example.title }}</h2>
        <span>
          <a href="{{ path('demo_conditionals_example', {id: example.id, kind: 'template'}) }}">template .docx</a>
          {% if not example.error %}
            &middot; <a href="{{ path('demo_conditionals_example', {id: example.id, kind: 'result'}) }}">generated .docx</a>
          {% endif %}
        </span>
      </div>
      <div class="nowo-ui-card__body">
        <p class="nowo-ui-muted">{{ example.note }}</p>
        <div class="nowo-ui-cards">
          <div>
            <h3>In Word</h3>
            <pre class="nowo-ui-code-block nowo-ui-code-block--wrap">{% for line in example.word %}{{ line }}
{% endfor %}</pre>
          </div>
          <div>
            <h3>In PHP</h3>
            <pre class="nowo-ui-code-block nowo-ui-code-block--wrap">{{ example.php }}</pre>
          </div>
          <div>
            <h3>Result</h3>
            {% if example.error %}
              <div class="nowo-ui-flash nowo-ui-flash--error" role="alert" data-testid="example-error-message"><code>ConditionalExpressionException</code>: {{ example.error }}</div>
            {% else %}
              <pre class="nowo-ui-code-block nowo-ui-code-block--wrap" data-testid="example-result">{% for line in example.lines %}{{ line }}
{% endfor %}</pre>
            {% endif %}
          </div>
        </div>
      </div>
    </section>
  {% endfor %}
{% endblock %}
